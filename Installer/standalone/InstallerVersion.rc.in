#include <windows.h>

// Real Lunar Player icon on the installer EXE (Explorer, taskbar,
// UAC prompt, Installed Apps).
IDI_ICON1 ICON "@LUNAR_ICON@"

// Version resource (single source: CMake project VERSION).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SSK\0"
            VALUE "FileDescription", "Lunar Player Installer\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "LunarPlayerInstaller\0"
            VALUE "LegalCopyright", "Copyright (C) SSK\0"
            VALUE "OriginalFilename", "LunarPlayerInstaller.exe\0"
            VALUE "ProductName", "Lunar Player\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
