<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="0.1.0.0" processorArchitecture="x86" name="LunarPlayerInstaller" type="win32" />
  <description>Lunar Player Installer</description>
  <!-- Machine-level install target (Program Files + shortcuts): the OS
       prompts for elevation at startup. Single elevated process, no
       in-installer UAC handoff. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe2-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
