<?xml version="1.0" encoding="UTF-8"?>
<!--
  LunarPlayer.msi — required payload (player + Qt + FFmpeg/Media Engine +
  updater + install.json template). File list is GENERATED at packaging
  time by heat.exe from the staged production payload (never hand-listed,
  never hardcoded). UpgradeCode is locked below; Product Id="*" per build.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define LunarVersion="$(env.LUNAR_VERSION)" ?>
  <?define AppUpgradeCode = "19dfe483-afb3-4442-a6cf-d63ae4774e95" ?>

  <Product Id="*" Name="Lunar Player" Language="1033"
           Version="$(var.LunarVersion)" Manufacturer="SSK"
           UpgradeCode="$(var.AppUpgradeCode)">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="Lunar Player media player"
             Manufacturer="SSK" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Lunar Player is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="LunarPlayer.exe" SourceFile="$(var.StageCore)\LunarPlayer.exe" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Lunar Player">
          <!-- heat-generated: <ComponentGroupRef Id="AppPayload" /> -->
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcuts" Name="Lunar Player">
          <Component Id="AppShortcut" Guid="*">
            <Shortcut Id="PlayerShortcut" Name="Lunar Player"
                      Target="[INSTALLFOLDER]LunarPlayer.exe"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="LunarPlayer.exe" />
            <RemoveFolder Id="AppShortcuts" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\SSK\Lunar Player\Shortcuts"
                           Name="installed" Value="1" Type="integer"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Core" Title="Lunar Player" Level="1">
      <ComponentGroupRef Id="AppPayload" />
      <ComponentRef Id="AppShortcut" />
    </Feature>
    <Feature Id="FFmpegEngine" Title="FFmpeg / Media Engine" Level="1">
      <ComponentGroupRef Id="FfmpegPayload" />
    </Feature>
  </Product>
</Wix>
